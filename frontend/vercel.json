{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "env": {
    "NEXT_PUBLIC_API_URL": "/api"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-saas-backend-ulpb.onrender.com/api/:path*"
    }
  ]
}
