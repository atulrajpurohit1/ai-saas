# Copy this file to .env and fill in real values. Never commit .env.
#
# The app checks this configuration at startup (src/config/environment-check.ts)
# and REFUSES TO BOOT if something required is missing, rather than failing on
# the first request that needs it. Warnings are logged and do not block boot.

# MUST be `production` on a production deploy. Several behaviours branch on it:
# leaving it unset writes every signup and password-reset OTP into the logs in
# CLEARTEXT, accepts localhost and Vercel preview CORS origins, and omits HSTS.
NODE_ENV=development

# PostgreSQL connection string (Neon or any Postgres instance). Required.
DATABASE_URL=

# JWT signing secrets and token lifetimes. Both required, both at least 32
# characters, and they MUST DIFFER from each other -- sharing one key lets an
# access token be replayed as a refresh token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts stored CRM OAuth tokens (HubSpot/GoHighLevel) at rest. Falls back to
# JWT_ACCESS_SECRET when unset -- which means rotating that secret makes every
# existing CRM connection undecryptable, so set this separately if CRM
# connectors are in use. There is deliberately no built-in default.
CRM_TOKEN_SECRET=

# --- CRM connectors (Integrations page) -------------------------------------
# Each connector stays "Not configured" (Connect button disabled) until ALL
# THREE of its vars are set. They come from an OAuth app you register with the
# CRM vendor -- they are app-level, not per-tenant.
#
# The redirect URI is the BACKEND origin plus /api/crm-connectors/<provider>/callback,
# and must match the one registered in the vendor's app settings character for
# character. After connecting, the backend sends the user to
# FRONTEND_URL/integrations, so FRONTEND_URL must be set as well.
#   local:      http://localhost:5000/api/crm-connectors/hubspot/callback
#   deployed:   https://your-backend-domain/api/crm-connectors/hubspot/callback
#
# HubSpot: developers.hubspot.com -> Apps -> Create app -> Auth tab. Add the
# redirect URL and the scope crm.objects.contacts.read, then copy the
# Client ID and Client secret.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
#
# GoHighLevel: marketplace.gohighlevel.com -> My Apps -> Create App. Scopes
# contacts.readonly and contacts.write; redirect path ends in /ghl/callback.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
#
# Salesforce: Setup -> App Manager -> New Connected App. Enable OAuth, scopes
# "api" and "refresh_token", and set the callback URL. Self-service, no
# approval needed.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=
#
# Pipedrive: developers.pipedrive.com -> Create an app. Scopes contacts:read
# and contacts:full. An unlisted/private app works immediately; only public
# marketplace listing needs review.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=
#
# Zoho CRM: api-console.zoho.com -> Server-based Applications. Scopes
# ZohoCRM.modules.contacts.ALL and ZohoCRM.settings.READ.
#
# Zoho is multi-datacenter. ZOHO_ACCOUNTS_HOST only decides which region the
# consent screen opens on - the user can switch, and each connection then
# follows whatever region they picked. Register the app in the datacenter
# most of your customers use (.com, .eu, .in, .com.au, .jp).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com

# Close, Freshsales and Copper need NO configuration here: each tenant
# connects by pasting their own API key on the Integrations page, so these
# three work out of the box with no app registration on our side.

# Google Gemini - primary AI provider. Powers proposals, sales coaching, RFP
# drafting, lead scoring AND Sales Calls audio transcription. One key, one
# vendor: no separate transcription account is needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_FALLBACK=true

# Optional override for audio transcription ONLY. OpenAI's speech-to-text is
# purpose-built and should handle difficult audio better than a general model,
# so setting this key switches transcription to it with no code change. Leave
# it unset to transcribe with Gemini. Requires an OpenAI *platform* account
# with prepaid credit - a ChatGPT subscription does not work.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Largest audio file accepted for transcription, in MB. Defaults to 12 on
# Gemini and 25 on OpenAI. Gemini carries the audio base64-encoded inside the
# request, which inflates it by about a third, so its ceiling is lower; raise
# this only if larger files are confirmed to work.
# TRANSCRIPTION_MAX_FILE_MB=

# BlackPearl (Bebop) company-playbook API - optional; when unset, Prospect
# Search insights fall back to the existing Gemini-based generation.
BLACKPEARL_API_KEY=
BLACKPEARL_BASE_URL=https://api.blackpearl.com/v1
BLACKPEARL_BRAND_PROFILE_KEY=

# Password given to every login created by scripts/seed-demo-showcase*.ts.
# Only needed when seeding the demo showcase tenant. Kept out of the scripts
# themselves because this repo is public and the demo tenant lives on the
# production database, so a literal in the source would be a working published
# login. Can also be passed as --password=<value>.
DEMO_SEED_PASSWORD=

# Shared store for the Prospect Search result cache and rate limiter.
# OPTIONAL. When unset, both fall back to per-process memory, which is correct
# for a SINGLE backend instance (the current deployment). Set this before
# running more than one instance: without it each instance keeps its own cache,
# so repeat searches re-run a billed BlackPearl job per instance, and the
# per-minute rate limit below becomes that value times the instance count.
# Redis is treated as a cache, never a source of truth - if it is unreachable
# the app logs and degrades to per-process behaviour rather than failing
# requests. Example: redis://default:<password>@<host>:6379
REDIS_URL=

# How long a Prospect Search result is reused before being re-fetched.
# Whole seconds; defaults to 300 (5 minutes).
PROSPECT_SEARCH_CACHE_TTL_SECONDS=

# Prospect Search requests allowed per user per minute. Defaults to 20.
PROSPECT_SEARCH_RATE_LIMIT_PER_MINUTE=

PORT=5000

# --- Email ---
# Used for proposal/RFP emails and for the signup + forgot-password OTP
# emails (EmailService). Transport priority:
#   BREVO_API_KEY  -> Brevo HTTPS API
#   RESEND_API_KEY -> Resend HTTPS API
#   neither        -> SMTP via the SMTP_* vars
#
# NOTE ON SMTP: Render's free tier (where this deploys) blocks outbound
# SMTP ports. Connections to smtp-relay.brevo.com:587 and
# smtp.resend.com:465 both time out after exactly connectionTimeout there,
# while the same hosts answer in ~130ms from an unrestricted network. So on
# Render, an HTTPS API key is required - SMTP settings will silently fail
# with "Connection timeout" no matter how correct the credentials are.
#
# OPTION A - Brevo HTTPS API (what production uses). Brevo needs only a
#   verified SENDER ADDRESS (confirm it by clicking a link in an email),
#   not a verified domain, so it works without DNS access and can send to
#   any recipient. Free tier is 300 emails/day.
#     BREVO_API_KEY=<API key from SMTP & API -> API Keys, starts xkeysib->
#     EMAIL_FROM=<the sender address verified under Senders>
#   The API key is NOT the same credential as the SMTP key on that page -
#   the API key is the one starting with "xkeysib-". EMAIL_FROM must match
#   a verified sender or Brevo rejects the send with "Sender is not valid".
#
# OPTION B - Resend HTTPS API.
#     RESEND_API_KEY=<your Resend API key>
#   Resend only delivers to the account owner's own address until you
#   verify a sending DOMAIN at resend.com/domains; every other recipient is
#   rejected with a 403 "You can only send testing emails to your own email
#   address". That domain requirement is why Brevo is used here instead.
#
# OPTION C - SMTP. Works anywhere outbound SMTP ports are open (i.e. NOT on
#   Render's free tier - see the note above). For Brevo, SMTP_USER is the
#   login from SMTP & API -> SMTP (like xxxxxxxx@smtp-brevo.com), NOT your
#   account email, and SMTP_PASS is the generated SMTP key, NOT your
#   account password.
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_USER=<the SMTP login>
#     SMTP_PASS=<the generated SMTP key>
#     EMAIL_FROM=<your verified sender address>
#   Port note: 465 is implicit TLS, 587 is STARTTLS. EmailService derives
#   nodemailer's `secure` flag from SMTP_PORT, so just set the port right.
#
# LOCAL DEV - leave everything blank and EmailService falls back to
# Ethereal (https://ethereal.email), a fake SMTP inbox that never delivers
# real mail. Send failures are logged and ignored outside production, and
# the OTP is printed to the server log so signup is never blocked.
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# The actual SMTP envelope "From" address for every email EmailService
# sends. In production this MUST be an address on a domain you have
# verified with your SMTP provider (e.g. verified in the Resend dashboard
# under Domains) - providers like Resend reject sends from an unverified
# domain. This is intentionally separate from a tenant's own
# admin-configured "support email" (Settings -> Branding), which is never
# domain-verified and is used only as the email's Reply-To address instead.
# Leave blank for local/Ethereal testing (a safe placeholder is used).
EMAIL_FROM=

# --- Prospect Search credit packs -----------------------------------------
# Customers buy credits to run AI Prospect Search: one credit covers one
# company playbook, or one prospect returned by a discovery search.
#
# NOTE: that one-credit-per-prospect mapping assumes BlackPearl bills per
# prospect, which has never been confirmed with them -- their API describes
# prepaid USD credit with token-based per-job usage. Pack sizes and list
# prices in src/billing/credit-packs.constants.ts are placeholders. Confirm
# real costs before selling against them.
#
# One Stripe Price id per pack, each a ONE-OFF price (not recurring), since
# packs are bought outright. A pack with no price id configured is simply not
# offered for sale, and the credits screen says so rather than 503-ing.
# Pack sizes and list prices live in src/billing/credit-packs.constants.ts.
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_PRO=
STRIPE_PRICE_CREDITS_ELITE=

# What one search costs the CUSTOMER, in our credits. Flat per search: the
# price does not change with how many prospects come back, because our own
# cost does not either (BlackPearl bills for AI compute, and a search that
# finds little is usually a hard, expensive one).
#
# Defaults are 5 (playbook) and 10 (discovery) and are PROVISIONAL -- nothing
# has calibrated them against real cost yet. Once CreditLedgerEntry rows carry
# upstream_cost_usd for a week or so, set these from the measured cost rather
# than a guess. Overridable here so tuning needs no deploy.
PROSPECT_PLAYBOOK_CREDIT_COST=
PROSPECT_DISCOVERY_CREDIT_COST=

# --- BlackPearl prepaid budget ---------------------------------------------
# Prospect Search runs on a FINITE prepaid balance with BlackPearl, shared by
# every tenant, with no overage to fall back on: when it is gone the feature
# stops for everybody at once. New searches are refused once the remaining
# balance falls to this many USD, leaving room for in-flight jobs to settle.
# Defaults to 25.
BLACKPEARL_RESERVE_FLOOR_USD=

# Credit balance below which billing contacts (ADMIN/FINANCE) are emailed a
# low-balance warning. A full discovery costs 200 credits by default, so the
# fallback of 500 means "fewer than three searches left". A tenant is warned
# once per drain cycle, not once per hourly sweep, and is re-armed when they
# top back up.
CREDIT_LOW_BALANCE_THRESHOLD=500

# --- AI feature credit prices ------------------------------------------------
# AI features are metered in the same credits as Prospect Search, so a customer
# has one balance to top up. Defaults are tiered: 5 for a short draft, 15 for a
# standard generation, 40 for analysis over a whole document, 1 for live call
# coaching (which fires repeatedly during one call).
#
# These defaults were derived from published Gemini rates and typical prompt
# sizes, NOT from measured traffic -- an AI call costs us roughly $0.002-$0.03,
# so they sit at about 5-20x cost. Recalibrate from GET /ai/usage/features once
# AiUsageEvent has real rows: averageCostUsd is the floor, maxCostUsd is the
# margin risk.
#
# Override any single feature with AI_CREDIT_COST_<FEATURE>, where <FEATURE> is
# an AiFeature enum value. A malformed value falls back to the default; only an
# explicit 0 makes a feature free.
# AI_CREDIT_COST_PROPOSAL_DRAFT=15
# AI_CREDIT_COST_SECURITY_RFP_ANALYSIS=40
# AI_CREDIT_COST_EMAIL_DRAFT=5

# --- Stripe checkout return URLs -------------------------------------------
# Where Stripe sends the customer back to after paying. This is the FRONTEND
# origin, not the backend's -- and it must be the EXACT origin customers sign
# in on. Sessions live in that origin's localStorage, so returning them to a
# different host (even another domain serving the same app) lands them with no
# session and bounces them to /login right after paying. Their credits still
# arrive, because the webhook is server-side, which is what makes this easy to
# miss.
#
# Leave it unset and the code falls back to FRONTEND_URL, then to
# http://localhost:3000 -- which means a customer paying on a deployed site is
# redirected to their OWN machine's localhost and sees nothing. Always set this
# explicitly in any deployed environment.
#
#   local:      http://localhost:3000
#   deployed:   https://your-frontend-domain
BILLING_RETURN_URL=

# --- Stripe webhooks --------------------------------------------------------
# Stripe calls the BACKEND directly, so the endpoint to register in the Stripe
# Dashboard is the backend origin plus /api/billing/webhook/stripe.
#
# Events the handler expects: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.payment_failed,
# charge.refunded, charge.dispute.created.
#
# Local development cannot receive webhooks directly (Stripe cannot reach
# localhost). Use the Stripe CLI, which prints its own signing secret:
#   stripe listen --forward-to localhost:5000/api/billing/webhook/stripe
#
# Without this set, payments succeed but NOTHING is provisioned -- the webhook
# rejects every unsigned request, so credits never arrive and subscriptions are
# never activated.
STRIPE_WEBHOOK_SECRET=

# --- Click-to-dial ----------------------------------------------------------
# Default country code applied to lead phone numbers stored WITHOUT one, e.g.
# "1" for US/Canada, "91" for India, "44" for the UK. Write it without the "+".
#
# Optional, and deliberately not defaulted in code: if a national number is
# saved with no country code and none is set here, the call is REFUSED rather
# than guessed. Guessing dials a real but wrong number in another country.
#
# Numbers already stored in international format (+14155551234) ignore this.
DEFAULT_PHONE_COUNTRY_CODE=
