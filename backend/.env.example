# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon or any Postgres instance).
DATABASE_URL=

# JWT signing secrets and token lifetimes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: enables audio transcription in Sales Calls.
# OPENAI_API_KEY=

# Google Gemini - primary AI provider (proposals, sales coaching, RFP drafting, etc).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_FALLBACK=true

# BlackPearl (Bebop) company-playbook API - optional; when unset, Prospect
# Search insights fall back to the existing Gemini-based generation.
BLACKPEARL_API_KEY=
BLACKPEARL_BASE_URL=https://api.blackpearl.com/v1
BLACKPEARL_BRAND_PROFILE_KEY=

PORT=5000

# --- Email ---
# Used for proposal/RFP emails and for the signup + forgot-password OTP
# emails (EmailService). EmailService picks its transport from these vars:
# RESEND_API_KEY set => Resend's HTTPS API; otherwise => SMTP via the
# SMTP_* vars below.
#
# OPTION A - Resend HTTPS API. Set RESEND_API_KEY only.
#   RESEND_API_KEY=<your Resend API key>
#
#   IMPORTANT: Resend will only deliver to the account owner's own address
#   until you verify a sending domain at resend.com/domains. Until then,
#   every other recipient is rejected with a 403 "You can only send testing
#   emails to your own email address". Verifying the domain also requires
#   setting EMAIL_FROM to an address ON that domain - leaving it as
#   onboarding@resend.dev keeps you in the restricted testing mode.
#
# OPTION B - Gmail SMTP. No domain verification needed, sends to anyone
#   immediately, ~500 emails/day. Requires 2-Step Verification on the
#   Google account so you can generate an App Password
#   (myaccount.google.com/apppasswords) - a normal account password will
#   NOT work.
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=<your.address@gmail.com>
#     SMTP_PASS=<16-character App Password>
#     EMAIL_FROM=<the same gmail address>
#   Leave RESEND_API_KEY blank/unset, or it takes precedence.
#
# LOCAL DEV - leave everything blank and EmailService falls back to
# Ethereal (https://ethereal.email), a fake SMTP inbox that never delivers
# real mail. Send failures are logged and ignored outside production, and
# the OTP is printed to the server log so signup is never blocked.
#
# Port note: 465 is implicit TLS and 587 is STARTTLS. EmailService derives
# nodemailer's `secure` flag from SMTP_PORT, so just set the port correctly.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# The actual SMTP envelope "From" address for every email EmailService
# sends. In production this MUST be an address on a domain you have
# verified with your SMTP provider (e.g. verified in the Resend dashboard
# under Domains) - providers like Resend reject sends from an unverified
# domain. This is intentionally separate from a tenant's own
# admin-configured "support email" (Settings -> Branding), which is never
# domain-verified and is used only as the email's Reply-To address instead.
# Leave blank for local/Ethereal testing (a safe placeholder is used).
EMAIL_FROM=
