# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon or any Postgres instance).
DATABASE_URL=

# JWT signing secrets and token lifetimes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: enables audio transcription in Sales Calls.
# OPENAI_API_KEY=

# Google Gemini - primary AI provider (proposals, sales coaching, RFP drafting, etc).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_FALLBACK=true

# BlackPearl (Bebop) company-playbook API - optional; when unset, Prospect
# Search insights fall back to the existing Gemini-based generation.
BLACKPEARL_API_KEY=
BLACKPEARL_BASE_URL=https://api.blackpearl.com/v1
BLACKPEARL_BRAND_PROFILE_KEY=

PORT=5000

# --- Email ---
# Used for proposal/RFP emails and for the signup + forgot-password OTP
# emails (EmailService).
#
# PRODUCTION (recommended): set RESEND_API_KEY and EmailService sends via
# Resend's HTTPS REST API, bypassing SMTP entirely. This is deliberate:
# many PaaS hosts (including Render's free tier, where this is deployed)
# block outbound SMTP ports (25/465/587) as an anti-spam measure, and a
# blocked port is indistinguishable from any other cause of a silent
# "Connection timeout". HTTPS is never blocked the same way.
#   RESEND_API_KEY=<your Resend API key>
#
# SMTP_PASS is still read as a fallback source for the Resend API key, so
# deployments configured before RESEND_API_KEY existed keep working with no
# env var change.
RESEND_API_KEY=

# SMTP settings below are only used when no Resend API key is set - i.e.
# local development against Ethereal (https://ethereal.email), a free
# fake-SMTP inbox that never delivers real mail. Leave blank to use the
# built-in Ethereal defaults already coded as fallbacks, or put a throwaway
# Ethereal account's host/port/user/pass here.
#
# Note if you do point these at a real SMTP relay: port 465 is implicit TLS
# and 587 is STARTTLS; EmailService derives that from SMTP_PORT for you.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# The actual SMTP envelope "From" address for every email EmailService
# sends. In production this MUST be an address on a domain you have
# verified with your SMTP provider (e.g. verified in the Resend dashboard
# under Domains) - providers like Resend reject sends from an unverified
# domain. This is intentionally separate from a tenant's own
# admin-configured "support email" (Settings -> Branding), which is never
# domain-verified and is used only as the email's Reply-To address instead.
# Leave blank for local/Ethereal testing (a safe placeholder is used).
EMAIL_FROM=
