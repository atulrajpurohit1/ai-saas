# Copy to /opt/aegislead/.env.production on the VPS, fill in, then:
#   chmod 600 .env.production && chown deploy:deploy .env.production
# It holds live Stripe keys and the database password. Never commit it.
#
# Two kinds of values live here:
#   - compose-level (image tags, Postgres credentials), read by
#     docker-compose.prod.yml itself;
#   - app-level, passed into the backend container via env_file.
# DATABASE_URL, REDIS_URL, NODE_ENV and PORT are NOT here: compose derives
# them from the values below so they cannot drift out of sync with the
# Postgres container.
#
# backend/.env.example documents every app variable in detail. This file lists
# the ones a production deploy must get right; anything optional and unset
# simply disables its feature (the API logs what is missing at boot and
# refuses to start if something required is absent).

# --- compose: which images this deploy runs ---------------------------------
# Set by the deploy workflow to the commit it built. To roll back, put the
# previous tag here and run `docker compose up -d`.
BACKEND_IMAGE=ghcr.io/atulrajpurohit1/aegislead-backend:latest
FRONTEND_IMAGE=ghcr.io/atulrajpurohit1/aegislead-frontend:latest

# --- compose: Postgres ------------------------------------------------------
# The container is not published on any port; this password guards access from
# within the compose network only. Generate it once and keep it in a password
# manager -- losing it does not lose the data, but every pg_dump needs it.
POSTGRES_DB=aegislead
POSTGRES_USER=aegislead
POSTGRES_PASSWORD=

# --- app: identity and URLs -------------------------------------------------
# Single origin: Nginx serves the API under /api on the same host, so there is
# no second domain and no CORS to configure.
FRONTEND_URL=https://dashboard.aegislead.co
CORS_ORIGINS=https://dashboard.aegislead.co
BILLING_RETURN_URL=https://dashboard.aegislead.co/billing
# MUST stay unset in production. Setting it trusts every ai-saas-*.vercel.app
# origin, a namespace anyone can create a project in.
# ALLOW_VERCEL_PREVIEW_ORIGINS=

# --- app: secrets (generate fresh ones, do NOT reuse staging's) -------------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 chars each, and the two JWT secrets must differ from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Encrypts stored CRM OAuth tokens. Set it BEFORE go-live: changing it later
# makes every existing CRM connection undecryptable.
CRM_TOKEN_SECRET=

# --- app: mail --------------------------------------------------------------
# Signup and password reset cannot complete without a working provider.
RESEND_API_KEY=
EMAIL_FROM=
# Or BREVO_API_KEY=, or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.

# --- app: object storage ----------------------------------------------------
# Use a DIFFERENT bucket from staging. Without these, uploads land on the
# container filesystem and vanish on the next deploy.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- app: Stripe (LIVE keys here, test keys on staging) ---------------------
STRIPE_SECRET_KEY=
# From the live webhook endpoint pointed at
# https://dashboard.aegislead.co/api/billing/webhook -- a different secret from
# the staging endpoint's.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_PRO=
STRIPE_PRICE_CREDITS_ELITE=
STRIPE_PRICE_LEAD_GEN_MONTHLY=
STRIPE_PRICE_GUARD_TOUR_MONTHLY=
STRIPE_PRICE_FINANCE_ANNUAL=
STRIPE_TRIAL_DAYS=

# --- app: AI ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
BLACKPEARL_API_KEY=
BLACKPEARL_BASE_URL=

# --- app: CRM connectors ----------------------------------------------------
# Each connector needs all three of its variables, and the redirect URI must be
# re-registered with the vendor against the production host:
#   https://dashboard.aegislead.co/api/crm-connectors/<provider>/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=

# --- backups (read by deploy/backup-db.sh) ----------------------------------
# Keep a copy of BACKUP_PASSPHRASE somewhere that is NOT this server: a dump
# encrypted with a passphrase that only exists on the box it backs up is not a
# backup.
BACKUP_PASSPHRASE=
B2_BACKUP_BUCKET=
B2_BACKUP_KEY_ID=
B2_BACKUP_APP_KEY=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
