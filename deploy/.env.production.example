# Production environment for the VPS stack.
#
#   cp .env.production.example .env.production
#   chown root:root .env.production && chmod 600 .env.production
#
# NEVER commit the filled-in copy -- this repo is public. .gitignore already
# covers .env.production, but check before you commit anyway.
#
# Boot-time validation lives in backend/src/config/environment-check.ts. It
# REFUSES TO START on the three vars marked FATAL below, and logs a warning for
# the rest. Read the warnings on the first deploy; each one names a feature
# that is silently broken.

# === FATAL if missing ======================================================

# Must be exactly `production`. Anything else -- including unset -- changes
# behaviour: an unset value is treated as production (safe default), but
# `development` would print every signup and password-reset OTP into the
# container logs in cleartext and accept localhost as a CORS origin.
NODE_ENV=production

# Points at the `db` service over the compose network, NOT at a public host.
# `db` is the service name and resolves inside the compose network only.
#
# The password must be PERCENT-ENCODED here if it contains any of : / ? # [ ] @
# -- Postgres URL parsing will otherwise truncate it and the connection fails
# with a confusing authentication error. Generate one without those characters:
#   openssl rand -base64 36 | tr -d '/+=' | head -c 40
DATABASE_URL=postgresql://aegislead:REPLACE_ME@db:5432/aegislead?schema=public

# Both required, both at least 32 characters, and they MUST DIFFER -- sharing
# one key lets an access token be replayed as a refresh token. These are NEW
# secrets, not the staging ones: reusing staging's would make a token minted on
# staging valid in production. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform console (/super-admin) signing secrets. REQUIRED -- the backend
# refuses to boot without them.
#
# These MUST be different values from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET
# above, and that is the entire security boundary between a tenant session and
# the platform console. If you reuse the tenant secret here, a tenant's own
# access token becomes forgeable into a platform token and every customer gets
# cross-tenant admin again -- which is exactly the bug this split fixed.
#
# Generate each one separately:
#   openssl rand -base64 48
JWT_PLATFORM_ACCESS_SECRET=
JWT_PLATFORM_REFRESH_SECRET=
# Deliberately shorter-lived than the tenant app's: this token carries
# authority over every tenant, so a stolen one should stop working sooner.
JWT_PLATFORM_ACCESS_EXPIRES_IN=30m
JWT_PLATFORM_REFRESH_EXPIRES_IN=8h

# === Postgres container =====================================================
# Read by the `db` service to initialise the cluster on FIRST start only.
# Changing POSTGRES_PASSWORD later does NOT change the existing role's
# password -- you must ALTER ROLE inside the database as well, and update
# DATABASE_URL above to match.
POSTGRES_USER=aegislead
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=aegislead

# === Caddy / TLS ============================================================
# The domain Caddy requests a certificate for. DNS must already resolve this to
# the VPS before the stack starts, or the ACME challenge fails and Let's
# Encrypt rate-limits repeated attempts.
SITE_DOMAIN=dashboard.aegislead.co
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=

# === Origins ================================================================
# The app and the API share this one origin (Caddy routes /api to the backend),
# so API calls are same-origin and no CORS preflight occurs. These are still
# set because several features build absolute URLs from them.
FRONTEND_URL=https://dashboard.aegislead.co
CORS_ORIGINS=https://dashboard.aegislead.co

# Must NOT be set in production. It would trust every `ai-saas-*.vercel.app`
# origin -- a namespace nobody controls, so anyone could create a matching
# project and be trusted with credentials. Left here, commented, as a marker.
# ALLOW_VERCEL_PREVIEW_ORIGINS=false

PORT=5000

# === Stripe =================================================================
# Production means LIVE keys (sk_live_...), not the test keys staging uses.
#
# STRIPE_WEBHOOK_SECRET is specific to one endpoint. Production needs its OWN
# endpoint registered at https://dashboard.aegislead.co/api/billing/webhook/stripe
# with its own signing secret -- staging's secret will not verify these
# requests. Without it, payments succeed but NOTHING is provisioned: credits
# never arrive and subscriptions never activate, because the handler rejects
# every unsigned request.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the customer after checkout. MUST be the exact origin
# they signed in on -- sessions live in that origin's localStorage, so a
# mismatch lands them logged out right after paying while their credits arrive
# anyway via the webhook. Easy to miss, hence its own variable.
BILLING_RETURN_URL=https://dashboard.aegislead.co

# Live-mode Price ids. These differ from the test-mode ids in staging: a
# test-mode price id is rejected by a live-mode key.
STRIPE_PRICE_LEAD_GEN_MONTHLY=
STRIPE_PRICE_LEAD_GEN_ANNUAL=
STRIPE_PRICE_GUARD_TOUR_MONTHLY=
STRIPE_PRICE_GUARD_TOUR_ANNUAL=
STRIPE_PRICE_FINANCE_MONTHLY=
STRIPE_PRICE_FINANCE_ANNUAL=
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_PRO=
STRIPE_PRICE_CREDITS_ELITE=
STRIPE_TRIAL_DAYS=

# === AI =====================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_FALLBACK=true

BLACKPEARL_API_KEY=
BLACKPEARL_BASE_URL=https://api.blackpearl.com/v1
BLACKPEARL_BRAND_PROFILE_KEY=

# === Email ==================================================================
# Brevo's HTTPS API, carried over from the current deploy. The SMTP-port
# restriction that forced this on Render does NOT apply on a VPS, so SMTP is an
# option here -- but there is no reason to change a working transport during a
# migration. EMAIL_FROM must match a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=

# === Object storage =========================================================
# Same Backblaze B2 bucket as today. Uploaded files live here rather than on
# the container filesystem, which is discarded on every deploy.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# === CRM connectors =========================================================
# Encrypts stored CRM OAuth tokens at rest. Set it explicitly: unset means
# tokens fall back to being encrypted under JWT_ACCESS_SECRET, so rotating
# that secret would make every existing CRM connection undecryptable.
# This MUST be the same value the current deploy uses, or already-connected
# tenants' tokens cannot be decrypted after the migration.
CRM_TOKEN_SECRET=

# Each redirect URI must be re-registered in the vendor's app settings to point
# at the production origin, character for character, or the OAuth callback is
# rejected. Staging keeps its own separate entries.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://dashboard.aegislead.co/api/crm-connectors/hubspot/callback

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://dashboard.aegislead.co/api/crm-connectors/zoho/callback
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com

PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=https://dashboard.aegislead.co/api/crm-connectors/pipedrive/callback

# === Optional ===============================================================
# Only needed once more than one backend container runs. With a single
# instance, the cache and rate limiter correctly use per-process memory.
# REDIS_URL=

# Country code applied to lead phone numbers stored without one, no "+".
# Deliberately not defaulted: with no value, a national number is REFUSED
# rather than dialled in the wrong country.
DEFAULT_PHONE_COUNTRY_CODE=
